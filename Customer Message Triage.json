    {
      "parameters": {
        "jsCode": "const base = $('Validate and Normalise Input').first().json;\nlet raw = $json;\nlet candidate;\ntry {\n  if (raw.error) throw new Error(typeof raw.error === 'string' ? raw.error : JSON.stringify(raw.error));\n  candidate = raw.output_text ?? raw.text ?? raw.message?.content ?? raw.choices?.[0]?.message?.content ?? raw.output?.[0]?.content?.[0]?.text;\n  if (typeof candidate === 'string') candidate = JSON.parse(candidate);\n  if (!candidate && raw.category) candidate = raw;\n  const enums={category:['delivery','trial_or_return','warranty','product_question','complaint','other'],urgency:['low','medium','high'],sentiment:['positive','neutral','negative']};\n  if (!candidate || typeof candidate !== 'object' || Array.isArray(candidate)) throw new Error('LLM result is not an object');\n  for (const [k,v] of Object.entries(enums)) if (!v.includes(candidate[k])) throw new Error(`Invalid ${k}`);\n  for (const k of ['summary','draft_reply']) if (typeof candidate[k] !== 'string' || !candidate[k].trim()) throw new Error(`${k} must be a non-empty string`);\n  return [{json:{...base,...candidate,ai_valid:true,failure_reason:''}}];\n} catch (e) { return [{json:{...base,ai_valid:false,failure_reason:`LLM failure or invalid output: ${e.message}`}}]; }"
      },
