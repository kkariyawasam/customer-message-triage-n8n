      "parameters": {
        "jsCode": "const body = $json.body;\nconst internalId = `triage-${Date.now()}-${Math.random().toString(36).slice(2,10)}`;\nconst receivedAt = new Date().toISOString();\nconst errors = [];\nif (!body || typeof body !== 'object' || Array.isArray(body)) errors.push('Request body must be a JSON object');\nconst source = body && typeof body === 'object' && !Array.isArray(body) ? body : {};\nfor (const key of ['message_id','message']) {\n  if (typeof source[key] !== 'string') errors.push(`${key} must be a string`);\n  else if (!source[key].trim()) errors.push(`${key} must not be empty`);\n}\nfor (const key of ['channel','customer_name','customer_email','order_number']) {\n  if (source[key] !== undefined && source[key] !== null && typeof source[key] !== 'string') errors.push(`${key} must be a string when provided`);\n}\nconst clean = {};\nfor (const key of ['message_id','message','channel','customer_name','customer_email','order_number']) clean[key] = typeof source[key] === 'string' ? source[key].trim() : '';\nreturn [{json:{...clean,internal_id:internalId,received_at:receivedAt,valid:errors.length===0,failure_reason:errors.join('; ')}}];"
      },
