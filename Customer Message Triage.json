    {
      "parameters": {
        "jsCode": "const p=$('Prepare Slack Signature').first().json; const input=$input.first().json; const calculated='v0='+String(input.data||input.hash||input.value||''); const provided=String(p.provided_signature||'').trim().toLowerCase(); const expected=calculated.trim().toLowerCase(); const format=/^v0=[0-9a-f]{64}$/; const same=format.test(provided)&&format.test(expected)&&provided.length===expected.length&&provided===expected; return [{json:{...p,signature_valid:Boolean(p.signature_fresh&&same)}}];"
      },
