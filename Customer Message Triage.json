    {
      "parameters": {
        "jsCode": "const input=$input.first(); const headers=input.json.headers||{}; const ts=String(headers['x-slack-request-timestamp']||''); const sig=String(headers['x-slack-signature']||''); let raw=''; if (input.binary?.data?.data) raw=Buffer.from(input.binary.data.data,'base64').toString('utf8'); else if (typeof $json.body==='string') raw=$json.body; else if ($json.body?.data && Array.isArray($json.body.data)) raw=Buffer.from($json.body.data).toString('utf8'); const fresh=/^\\d+$/.test(ts)&&Math.abs(Date.now()/1000-Number(ts))<=300; return [{json:{ts,provided_signature:sig,signature_fresh:fresh,raw_body:raw,signature_base:`v0:${ts}:${raw}`}}];"
      },
      "id": "04b0e978-14ca-4749-8d04-929308f65ad6",
      "name": "Prepare Slack Signature",
      "type": "n8n-nodes-base.code",
