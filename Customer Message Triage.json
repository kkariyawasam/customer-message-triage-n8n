      "parameters": {
        "jsCode": "const esc=s=>String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/@/g,'＠');\nconst j=$json;\nconst reviewTitle=j.customer_name?`Message from ${String(j.customer_name).slice(0,100)} — review required`:'Customer message — review required';\nconst blocks={blocks:[{type:'header',text:{type:'plain_text',text:reviewTitle}},{type:'section',fields:[{type:'mrkdwn',text:`*Message ID*\\n${esc(j.message_id)}`},{type:'mrkdwn',text:`*Category / urgency / sentiment*\\n${esc(j.category)} / ${esc(j.urgency)} / ${esc(j.sentiment)}`}]},{type:'section',text:{type:'mrkdwn',text:`*Summary*\\n${esc(j.summary)}`}},{type:'section',text:{type:'mrkdwn',text:`*DRAFT — do not send without review*\\n${esc(j.draft_reply)}`}},{type:'section',text:{type:'mrkdwn',text:`*Original message*\\n${esc(j.message)}\\n\\n*Channel:* ${esc(j.channel||'not provided')}  *Order:* ${esc(j.order_number||'not provided')}`}},{type:'actions',elements:[{type:'button',text:{type:'plain_text',text:'Approve'},style:'primary',action_id:'triage_approve',value:`${j.internal_id}|approve`},{type:'button',text:{type:'plain_text',text:'Reject'},style:'danger',action_id:'triage_reject',value:`${j.internal_id}|reject`}]}]};\nreturn [{json:{...j,slack_blocks:JSON.stringify(blocks)}}];"
      },
