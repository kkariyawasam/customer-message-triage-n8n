    {
      "parameters": {
        "jsCode": "const raw=String($input.first().json.raw_body||'');\nconst encoded=raw.split('&').find(part=>part.startsWith('payload='))?.slice(8)||'';\nconst payload=JSON.parse(decodeURIComponent(encoded.replace(/\\+/g,' '))||'{}');\nconst action=payload.actions?.[0];\nconst [internal_id,decision]=String(action?.value||'').split('|');\nif (!internal_id || !['approve','reject'].includes(decision)) throw new Error('Invalid callback action');\nconst response_url=String(payload.response_url||'');\nif (!/^https:\\/\\/hooks\\.slack\\.com\\/actions\\//.test(response_url)) throw new Error('Invalid Slack response URL');\nconst status=decision==='approve'?'approved':'rejected';\nconst decision_label=decision==='approve'?'✅ Approved':'❌ Rejected';\nconst originalBlocks=Array.isArray(payload.message?.blocks)?payload.message.blocks:[];\nconst blocks=originalBlocks.filter(block=>block?.type!=='actions');\nblocks.splice(Math.min(1,blocks.length),0,{type:'section',text:{type:'mrkdwn',text:decision_label}});\nconst slack_update_body=JSON.stringify({replace_original:true,text:decision_label,blocks});\nreturn [{json:{internal_id,decision,status,decision_label,decided_by:payload.user?.id||'',decided_at:new Date().toISOString(),response_url,slack_update_body}}];"
